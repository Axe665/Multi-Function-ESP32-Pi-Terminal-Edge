# 边节点的对外入口：只绑本机，公网访问靠前面的反向隧道或 VPN
:8001 {
	# 端 → 边的摄取（HTTP 通道，MQTT 直连 mosquitto:8883）
	@ingest path /api/v1/ingest/*
	handle @ingest {
		reverse_proxy ingest:8001
	}

	# 管理 API：查询、配对、证书、设置、上云
	handle /api/* {
		reverse_proxy api:8001
	}

	# 其余是静态前端
	handle {
		root * /srv/web
		encode gzip
		# index.html 不回缓存，否则旧标签页永远停在上一版；带 hash 的产物反过来长缓存
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@noassets not path /assets/*
		header @noassets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
