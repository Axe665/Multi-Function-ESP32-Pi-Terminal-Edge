# 边节点部署变量（docker/compose.yml 用）
# 复制成 .env 后按需改；不填就用括号里的默认值

EDGE_ID=edge-lab-01
EDGE_NAME=实验室边节点

# 端 → 边 MQTT（broker 证书用 scripts/make_broker_cert.py 生成）
EDGE_MQTT_HOST=mosquitto
EDGE_MQTT_PORT=8883

# 边 → 云；优先用 mDNS 发现的地址，这里填静态兜底。都没有才留在本机发件箱
EDGE_CLOUD_URL=
EDGE_CLOUD_TOKEN=

# 入口鉴权；多机部署务必设置
EDGE_INGEST_TOKEN=
EDGE_ADMIN_TOKEN=

# k 门槛（文档要求 5）
EDGE_K_MIN=5

# 写入口防护（文档 §8.4）：每分钟每 IP 上限；磁盘余量低于多少 MB 就拒收（0 = 关闭）
EDGE_INGEST_RATE=120
EDGE_MIN_FREE_MB=512

# 演示数据：1 = 每 5 分钟补窗口；接真机改 0
EDGE_SIM=1

# 基础镜像源。Docker Hub 拉不动时换成镜像站，例如
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
PYTHON_IMAGE=python:3.11-slim
# 依赖源，同上
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
