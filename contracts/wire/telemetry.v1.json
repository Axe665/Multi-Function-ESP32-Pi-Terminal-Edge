{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Axe665/Multi-Function-ESP32-Pi-Terminal/contracts/wire/telemetry.v1.json",
  "title": "orpi.telemetry.v1 —— 端 → 边",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device_id", "edge_id", "sent_at", "window", "privacy"],
  "properties": {
    "schema": { "const": "orpi.telemetry.v1" },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "edge_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sent_at": { "type": "integer", "description": "epoch ms" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "step_ms"],
      "properties": {
        "from": { "type": "integer" },
        "to": { "type": "integer" },
        "step_ms": { "type": "integer", "minimum": 1000 }
      }
    },
    "aggregates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "module_id", "n_subjects", "n_samples", "mean", "k"],
        "properties": {
          "metric": { "type": "string", "minLength": 1, "maxLength": 64 },
          "module_id": { "type": "integer", "minimum": 0 },
          "n_subjects": { "type": "integer", "minimum": 1 },
          "n_samples": { "type": "integer", "minimum": 1 },
          "mean": { "type": "number" },
          "slope": { "type": "number" },
          "z": { "type": "number" },
          "k": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "advice": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "risk", "confidence", "source"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 160 },
          "risk": { "enum": ["info", "watch", "alert"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["local", "cloud", "api"] }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "pseudonym", "raw"],
      "properties": {
        "k": { "type": "integer", "minimum": 1 },
        "pseudonym": { "const": "hmac16" },
        "raw": { "const": false, "description": "true 一律拒收" },
        "suppressed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
