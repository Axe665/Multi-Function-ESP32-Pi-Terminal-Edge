# 边节点运行环境（复制为 deploy/edge.env 后按需修改）
EDGE_SIM=0
EDGE_AUTOSEED=0
EDGE_LAN_IP=192.168.31.71
EDGE_MQTT_HOST=mqtt.edge.local
EDGE_MQTT_PORT=18883
EDGE_MQTT_CA=@ROOT@/docker/mosquitto/certs/ca.crt
EDGE_MQTT_CERT=@ROOT@/docker/mosquitto/certs/edge.crt
EDGE_MQTT_KEY=@ROOT@/docker/mosquitto/certs/edge.key
# 云连接（可选）
# EDGE_CLOUD_URL=https://cloud.local:8443
# EDGE_CLOUD_CA=@ROOT@/cloud-certs/cloud-ca.crt
# EDGE_CLOUD_CERT=@ROOT@/cloud-certs/edge.crt
# EDGE_CLOUD_KEY=@ROOT@/cloud-certs/edge.key
# EDGE_CLOUD_TOKEN=
