[Unit]
Description=Modular Terminal Edge（边节点）
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/deploy/edge.env
ExecStart=@ROOT@/.venv/bin/python -m uvicorn edge.main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
