[Unit]
Description=Modular Terminal Edge（边节点）
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/deploy/edge.env
# 管理台按文档只在内网：绑 loopback，外网靠隧道/VPN。绑 0.0.0.0 又没有
# EDGE_ADMIN_TOKEN 时，同网段任何人可以配对取码、换证书、改设置
ExecStart=@ROOT@/.venv/bin/python -m uvicorn edge.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
